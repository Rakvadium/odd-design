{
  "name": "odd-design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-free, accessible design system. Chrome sets the feel, palette sets the color.",
  "exports": {
    ".": "./src/css/index.css",
    "./appearance": "./src/js/appearance.ts",
    "./enhance": "./src/js/enhance.ts",
    "./palette": "./src/js/palette.ts",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./usage": {
      "types": "./dist/js/usage/dom.d.ts",
      "import": "./dist/js/usage/dom.js",
      "default": "./dist/js/usage/dom.js"
    },
    "./usage/test-setup": {
      "types": "./dist/js/usage/test-setup.d.ts",
      "import": "./dist/js/usage/test-setup.js",
      "default": "./dist/js/usage/test-setup.js"
    },
    "./eslint": {
      "types": "./dist/eslint/plugin.d.ts",
      "import": "./dist/eslint/plugin.js",
      "default": "./dist/eslint/plugin.js"
    }
  },
  "files": [
    "dist",
    "docs/usage",
    "src/css",
    "src/js"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:react": "storybook dev -c .storybook-react -p 6007 --no-open",
    "build-storybook": "bun scripts/storybooks.ts storybook-static",
    "build": "bun scripts/build.ts",
    "test": "bun test tests",
    "test:browsers": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@html-eslint/eslint-plugin": "0.67.0",
    "@html-eslint/parser": "0.67.0",
    "@html-eslint/template-parser": "0.67.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/html-vite": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/bun": "^1.4.3",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "culori": "^4.0.2",
    "eslint": "10.13.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
