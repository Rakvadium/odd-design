{
  "name": "odd-design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-free, accessible design system. Chrome sets the feel, palette sets the color.",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/css.d.ts",
      "default": "./dist/odd-design.css"
    },
    "./fonts.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/fonts.css"
    },
    "./appearance": {
      "types": "./dist/appearance.d.ts",
      "default": "./dist/appearance.js"
    },
    "./first-paint.js": "./dist/first-paint.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepare": "bun scripts/build.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/html-vite": "10.6.2",
    "@types/bun": "^1.4.3",
    "@types/culori": "^4.0.1",
    "culori": "^4.0.2",
    "storybook": "10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
