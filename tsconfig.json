{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "odd-design/react": ["./src/react/button.tsx"]
    }
  },
  "include": ["src", "stories", "tests", ".storybook", "e2e", "playwright.config.ts"],
  "exclude": ["tests/fixtures"]
}
