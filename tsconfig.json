{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "odd-design/react": ["./src/react/index.ts"]
    }
  },
  "include": ["src", "stories", "tests", ".storybook", ".storybook-react", ".storybook-composed", "scripts/capture-stories.ts", "scripts/storybooks.ts", "e2e", "playwright.config.ts", "eval"],
  "exclude": ["tests/fixtures", "eval/template", "eval/seeds"]
}
